<?xml version="1.0"?>
<pipeline ssi-v="1">

    <register>
        <load name="ssipython310" />
        <load name="ssigraphic" />
        <load name="ssiioput" />
    </register>

    <sensor create="PythonSensor" script="movella" syspath="." block="0.1">
        <output channel="sensor" pin="dot_full" />
    </sensor>

    <consumer create="FileWriter" path="my_data_9ch" type="1">
        <input pin="dot_full" frame="0.1s" />
    </consumer>

    <consumer create="SignalPainter" title="Movella DOT 9-ch Data" type="2">
        <input pin="dot_full" frame="0.1s" />
    </consumer>

</pipeline>